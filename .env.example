# Copy to .env at repository root. Never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://mimi:mimi_dev_only@localhost:5432/mimi?schema=public
TEST_DATABASE_URL=postgresql://mimi:mimi_dev_only@localhost:5433/mimi_test?schema=public
REDIS_URL=redis://localhost:6379
TRUST_PROXY=false
# false only for HTTP local development. Production requires true and HTTPS.
COOKIE_SECURE=false
# console is development-only; production requires an authenticated SMTP service.
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Web: leave blank when reverse-proxying /api; otherwise provide the API origin.
VITE_API_ORIGIN=
