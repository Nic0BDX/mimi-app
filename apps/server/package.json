{
  "name": "@mimi/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@mimi/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "fastify": "5.12.8",
    "nodemailer": "10.6.0",
    "socket.io": "4.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "7.0.3",
    "dotenv-cli": "10.0.0",
    "prisma": "6.19.3",
    "tsup": "8.5.0",
    "tsx": "4.20.6"
  }
}
