{
  "name": "mimi-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "glob": "14.0.2",
      "minimatch": "11.0.1"
    }
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"pnpm --filter @mimi/server dev\" \"pnpm --filter @mimi/web dev\"",
    "build": "pnpm --filter @mimi/shared build && pnpm --filter @mimi/server build && pnpm --filter @mimi/web build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:runtime": "pnpm --filter @mimi/server exec tsx ../../tools/runtime-smoke.mjs",
    "db:generate": "pnpm --filter @mimi/server db:generate",
    "db:migrate": "pnpm --filter @mimi/server db:migrate",
    "db:test:start": "node tools/test-postgres.mjs",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:runtime && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.1",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "10.0.7",
    "dotenv": "16.6.1",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "sharp": "0.35.5",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "5.1.0"
  }
}
